# ---- Tier 1: NAAP dev environment (allowlisted non-prod only) ----
NAAP_DEV_BASE_URL=
# Legacy endpoints are /api/questions etc.; v4 are /api/v4/acquire/*.
# VERIFY which generation the target NAAP env serves, then set:
NAAP_API_STYLE=legacy            # legacy | v4

# Cognito client-credentials (M2M)
NAAP_TOKEN_URL=
NAAP_CLIENT_ID=
NAAP_CLIENT_SECRET=
NAAP_OAUTH_SCOPE=

# ---- Tier 2: local virtualized harness ----
HARNESS_BASE_URL=http://localhost:8080

# Query param sent on every API call (verified from NAAP stg URL)
NAAP_LANGUAGE=en-US
